{
  "$defs": {
    "Ability": {
      "additionalProperties": false,
      "description": "A hero / enemy / boss ability (CombatCard).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "target_type": {
          "default": "single_enemy",
          "enum": [
            "single_enemy",
            "all_enemies",
            "self",
            "all_allies",
            "lowest_hp_ally"
          ],
          "title": "Target Type",
          "type": "string"
        },
        "lane_scope": {
          "default": "same_lane",
          "enum": [
            "same_lane",
            "adjacent_lanes",
            "any_lane",
            "all_lanes"
          ],
          "title": "Lane Scope",
          "type": "string"
        },
        "power_multiplier": {
          "default": 1.0,
          "description": "Damage = attack \u00d7 this.",
          "minimum": 0.0,
          "title": "Power Multiplier",
          "type": "number"
        },
        "heal_multiplier": {
          "default": 0.0,
          "description": "Heal = attack \u00d7 this.",
          "minimum": 0.0,
          "title": "Heal Multiplier",
          "type": "number"
        },
        "shield_grant": {
          "default": 0,
          "minimum": 0,
          "title": "Shield Grant",
          "type": "integer"
        },
        "cooldown_turns": {
          "default": 0,
          "description": "Own turns before it can be used again.",
          "minimum": 0,
          "title": "Cooldown Turns",
          "type": "integer"
        },
        "summon_troop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Troop template summoned into the target lane.",
          "title": "Summon Troop Id"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "telegraph_turns": {
          "default": 0,
          "description": "Bosses: own turns spent winding up before it lands.",
          "minimum": 0,
          "title": "Telegraph Turns",
          "type": "integer"
        },
        "phase": {
          "default": 0,
          "description": "Bosses: 0-based phase from which it is unlocked.",
          "minimum": 0,
          "title": "Phase",
          "type": "integer"
        },
        "energy_cost": {
          "default": 0,
          "description": "Legacy card mode only.",
          "minimum": 0,
          "title": "Energy Cost",
          "type": "integer"
        },
        "icon_name": {
          "default": "Zap",
          "title": "Icon Name",
          "type": "string"
        },
        "flavor_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor Quote"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Ability",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "A buff / debuff an ability or passive applies, or an op (CLEANSE / STRIP / STEAL).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "type": {
          "enum": [
            "ATK_UP",
            "DEF_UP",
            "SPD_UP",
            "CRIT_UP",
            "IMMUNITY",
            "REGEN",
            "ATK_DOWN",
            "DEF_DOWN",
            "SPD_DOWN",
            "BURN",
            "POISON",
            "STUN",
            "HEAL_BLOCK",
            "MARKED",
            "CLEANSE",
            "STRIP",
            "STEAL"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "default": "hit",
          "description": "self | ally (healed/chosen ally) | allies (all allies in reach) | hit (enemies damaged) | enemies (all enemies in reach)",
          "enum": [
            "self",
            "ally",
            "allies",
            "hit",
            "enemies"
          ],
          "title": "Target",
          "type": "string"
        },
        "value": {
          "default": 0.0,
          "description": "Strength: 0.3 = 30% (stat effects / MARKED) or 30% max HP per turn (BURN/POISON/REGEN).",
          "title": "Value",
          "type": "number"
        },
        "turns": {
          "default": 2,
          "description": "Duration in the holder's own turns.",
          "minimum": 0,
          "title": "Turns",
          "type": "integer"
        },
        "chance": {
          "default": 1.0,
          "description": "Base land chance for debuffs (Accuracy vs Resistance applies).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Chance",
          "type": "number"
        },
        "count": {
          "default": 1,
          "description": "CLEANSE / STRIP / STEAL: number of effects affected.",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Enemy": {
      "additionalProperties": false,
      "description": "A hostile prototype. Non-elite entries fight as troop packs; elites (and difficulty\n\"elite\"/\"boss\" threats) fight as enemy heroes with abilities.",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "hp": {
          "exclusiveMinimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "shields": {
          "default": 0,
          "minimum": 0,
          "title": "Shields",
          "type": "integer"
        },
        "attack": {
          "minimum": 0,
          "title": "Attack",
          "type": "integer"
        },
        "defense": {
          "minimum": 0,
          "title": "Defense",
          "type": "integer"
        },
        "speed": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "integer"
        },
        "is_elite": {
          "default": false,
          "title": "Is Elite",
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "troop",
                "elite",
                "boss"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Difficulty threats only: troop / elite / boss.",
          "title": "Role"
        },
        "min_tier": {
          "default": 1,
          "description": "Difficulty threats only: first tier it appears.",
          "maximum": 10,
          "minimum": 1,
          "title": "Min Tier",
          "type": "integer"
        },
        "passive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Passive"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/Ability"
          },
          "title": "Cards",
          "type": "array"
        },
        "summons": {
          "additionalProperties": {
            "$ref": "#/$defs/Summon"
          },
          "title": "Summons",
          "type": "object"
        }
      },
      "required": [
        "name",
        "hp",
        "attack",
        "defense"
      ],
      "title": "Enemy",
      "type": "object"
    },
    "Passive": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "STACK_ON_TURN_END",
            "PER_ALLY_TROOP",
            "LOW_HP",
            "LANE_AURA",
            "REGEN",
            "SHIELD_REGEN",
            "ON_KILL_METER",
            "ON_HIT_EFFECT",
            "DAMAGE_VS_DEBUFFED",
            "BATTLE_START_EFFECT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stat": {
          "anyOf": [
            {
              "enum": [
                "attack",
                "defense",
                "speed",
                "crit_rate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stat"
        },
        "value": {
          "default": 0.0,
          "title": "Value",
          "type": "number"
        },
        "max_stacks": {
          "default": 0,
          "title": "Max Stacks",
          "type": "integer"
        },
        "threshold": {
          "default": 0.0,
          "description": "LOW_HP: HP ratio below which it triggers.",
          "title": "Threshold",
          "type": "number"
        },
        "lane_wide": {
          "default": false,
          "description": "REGEN: heal the whole lane instead of self.",
          "title": "Lane Wide",
          "type": "boolean"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "Passive",
      "type": "object"
    },
    "Summon": {
      "additionalProperties": false,
      "description": "An enemy-side summonable pack (scaled with the encounter).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "unit_hp": {
          "exclusiveMinimum": 0,
          "title": "Unit Hp",
          "type": "integer"
        },
        "unit_attack": {
          "minimum": 0,
          "title": "Unit Attack",
          "type": "integer"
        },
        "defense": {
          "default": 5,
          "title": "Defense",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "count",
        "unit_hp",
        "unit_attack"
      ],
      "title": "Summon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A planet (biome): expedition setting, enemy pool and difficulty threats.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Editor hint, ignored by the game.",
      "title": "$Schema"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "hazard_name": {
      "title": "Hazard Name",
      "type": "string"
    },
    "hazard_description": {
      "title": "Hazard Description",
      "type": "string"
    },
    "recommended_power": {
      "title": "Recommended Power",
      "type": "integer"
    },
    "allowed_artifact_sets": {
      "items": {
        "enum": [
          "Hyper-Thrusters",
          "Bio-Leech",
          "Psionic Aegis",
          "Gauss Overcharge",
          "Precision Matrix"
        ],
        "type": "string"
      },
      "title": "Allowed Artifact Sets",
      "type": "array"
    },
    "color": {
      "title": "Color",
      "type": "string"
    },
    "bg_gradient": {
      "title": "Bg Gradient",
      "type": "string"
    },
    "icon_name": {
      "title": "Icon Name",
      "type": "string"
    },
    "max_difficulty": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Difficulty",
      "type": "integer"
    },
    "order": {
      "default": 100,
      "description": "Position on the Sector Map (lower first).",
      "title": "Order",
      "type": "integer"
    },
    "image": {
      "default": "/assets/planets/char.png",
      "description": "Planet art (transparent PNG) shown on the Sector Map.",
      "title": "Image",
      "type": "string"
    },
    "image_hue": {
      "default": 0,
      "description": "Hue rotation (deg) applied to the art \u2014 placeholder tinting until unique art exists.",
      "title": "Image Hue",
      "type": "integer"
    },
    "enemy_pool": {
      "items": {
        "$ref": "#/$defs/Enemy"
      },
      "minItems": 1,
      "title": "Enemy Pool",
      "type": "array"
    },
    "difficulty_enemies": {
      "items": {
        "$ref": "#/$defs/Enemy"
      },
      "title": "Difficulty Enemies",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "hazard_name",
    "hazard_description",
    "recommended_power",
    "allowed_artifact_sets",
    "color",
    "bg_gradient",
    "icon_name",
    "enemy_pool"
  ],
  "title": "Planet",
  "type": "object",
  "$id": "planet.schema.json"
}
