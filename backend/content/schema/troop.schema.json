{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "credits": {
          "default": 0,
          "minimum": 0,
          "title": "Credits",
          "type": "integer"
        },
        "crystals": {
          "default": 0,
          "minimum": 0,
          "title": "Crystals",
          "type": "integer"
        }
      },
      "title": "Cost",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A troop pack deployed from the reserve with mana (or summoned). Pack HP = count \u00d7 unit_hp.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Editor hint, ignored by the game.",
      "title": "$Schema"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "faction": {
      "enum": [
        "Terran Vanguard",
        "Bio-Swarm",
        "Astral Templars"
      ],
      "title": "Faction",
      "type": "string"
    },
    "count": {
      "exclusiveMinimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "unit_hp": {
      "exclusiveMinimum": 0,
      "title": "Unit Hp",
      "type": "integer"
    },
    "unit_attack": {
      "minimum": 0,
      "title": "Unit Attack",
      "type": "integer"
    },
    "defense": {
      "minimum": 0,
      "title": "Defense",
      "type": "integer"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "icon_name": {
      "default": "Users",
      "title": "Icon Name",
      "type": "string"
    },
    "mana_cost": {
      "default": 3,
      "description": "Mana spent to deploy this pack from the reserve during battle.",
      "minimum": 0,
      "title": "Mana Cost",
      "type": "integer"
    },
    "cost": {
      "$ref": "#/$defs/Cost",
      "description": "Barracks: price to train one pack."
    },
    "requires": {
      "description": "Barracks: upgrade ids (structures) needed to train it.",
      "items": {
        "type": "string"
      },
      "title": "Requires",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "faction",
    "count",
    "unit_hp",
    "unit_attack",
    "defense"
