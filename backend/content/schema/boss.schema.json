{
  "$defs": {
    "Ability": {
      "additionalProperties": false,
      "description": "A hero / enemy / boss ability (CombatCard).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "target_type": {
          "default": "single_enemy",
          "enum": [
            "single_enemy",
            "all_enemies",
            "self",
            "all_allies",
            "lowest_hp_ally"
          ],
          "title": "Target Type",
          "type": "string"
        },
        "lane_scope": {
          "default": "same_lane",
          "enum": [
            "same_lane",
            "adjacent_lanes",
            "any_lane",
            "all_lanes"
          ],
          "title": "Lane Scope",
          "type": "string"
        },
        "power_multiplier": {
          "default": 1.0,
          "description": "Damage = attack \u00d7 this.",
          "minimum": 0.0,
          "title": "Power Multiplier",
          "type": "number"
        },
        "heal_multiplier": {
          "default": 0.0,
          "description": "Heal = attack \u00d7 this.",
          "minimum": 0.0,
          "title": "Heal Multiplier",
          "type": "number"
        },
        "shield_grant": {
          "default": 0,
          "minimum": 0,
          "title": "Shield Grant",
          "type": "integer"
        },
        "cooldown_turns": {
          "default": 0,
          "description": "Own turns before it can be used again.",
          "minimum": 0,
          "title": "Cooldown Turns",
          "type": "integer"
        },
        "summon_troop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Troop template summoned into the target lane.",
          "title": "Summon Troop Id"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "telegraph_turns": {
          "default": 0,
          "description": "Bosses: own turns spent winding up before it lands.",
          "minimum": 0,
          "title": "Telegraph Turns",
          "type": "integer"
        },
        "phase": {
          "default": 0,
          "description": "Bosses: 0-based phase from which it is unlocked.",
          "minimum": 0,
          "title": "Phase",
          "type": "integer"
        },
        "energy_cost": {
          "default": 0,
          "description": "Legacy card mode only.",
          "minimum": 0,
          "title": "Energy Cost",
          "type": "integer"
        },
        "icon_name": {
          "default": "Zap",
          "title": "Icon Name",
          "type": "string"
        },
        "flavor_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor Quote"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Ability",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "A buff / debuff an ability or passive applies, or an op (CLEANSE / STRIP / STEAL).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "type": {
          "enum": [
            "ATK_UP",
            "DEF_UP",
            "SPD_UP",
            "CRIT_UP",
            "IMMUNITY",
            "REGEN",
            "ATK_DOWN",
            "DEF_DOWN",
            "SPD_DOWN",
            "BURN",
            "POISON",
            "STUN",
            "HEAL_BLOCK",
            "MARKED",
            "CLEANSE",
            "STRIP",
            "STEAL"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "default": "hit",
          "description": "self | ally (healed/chosen ally) | allies (all allies in reach) | hit (enemies damaged) | enemies (all enemies in reach)",
          "enum": [
            "self",
            "ally",
            "allies",
            "hit",
            "enemies"
          ],
          "title": "Target",
          "type": "string"
        },
        "value": {
          "default": 0.0,
          "description": "Strength: 0.3 = 30% (stat effects / MARKED) or 30% max HP per turn (BURN/POISON/REGEN).",
          "title": "Value",
          "type": "number"
        },
        "turns": {
          "default": 2,
          "description": "Duration in the holder's own turns.",
          "minimum": 0,
          "title": "Turns",
          "type": "integer"
        },
        "chance": {
          "default": 1.0,
          "description": "Base land chance for debuffs (Accuracy vs Resistance applies).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Chance",
          "type": "number"
        },
        "count": {
          "default": 1,
          "description": "CLEANSE / STRIP / STEAL: number of effects affected.",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Enemy": {
      "additionalProperties": false,
      "description": "A hostile prototype. Non-elite entries fight as troop packs; elites (and difficulty\n\"elite\"/\"boss\" threats) fight as enemy heroes with abilities.",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "hp": {
          "exclusiveMinimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "shields": {
          "default": 0,
          "minimum": 0,
          "title": "Shields",
          "type": "integer"
        },
        "attack": {
          "minimum": 0,
          "title": "Attack",
          "type": "integer"
        },
        "defense": {
          "minimum": 0,
          "title": "Defense",
          "type": "integer"
        },
        "speed": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "integer"
        },
        "is_elite": {
          "default": false,
          "title": "Is Elite",
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "troop",
                "elite",
                "boss"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Difficulty threats only: troop / elite / boss.",
          "title": "Role"
        },
        "min_tier": {
          "default": 1,
          "description": "Difficulty threats only: first tier it appears.",
          "maximum": 10,
          "minimum": 1,
          "title": "Min Tier",
          "type": "integer"
        },
        "passive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Passive"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/Ability"
          },
          "title": "Cards",
          "type": "array"
        },
        "summons": {
          "additionalProperties": {
            "$ref": "#/$defs/Summon"
          },
          "title": "Summons",
          "type": "object"
        }
      },
      "required": [
        "name",
        "hp",
        "attack",
        "defense"
      ],
      "title": "Enemy",
      "type": "object"
    },
    "Passive": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "STACK_ON_TURN_END",
            "PER_ALLY_TROOP",
            "LOW_HP",
            "LANE_AURA",
            "REGEN",
            "SHIELD_REGEN",
            "ON_KILL_METER",
            "ON_HIT_EFFECT",
            "DAMAGE_VS_DEBUFFED",
            "BATTLE_START_EFFECT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stat": {
          "anyOf": [
            {
              "enum": [
                "attack",
                "defense",
                "speed",
                "crit_rate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stat"
        },
        "value": {
          "default": 0.0,
          "title": "Value",
          "type": "number"
        },
        "max_stacks": {
          "default": 0,
          "title": "Max Stacks",
          "type": "integer"
        },
        "threshold": {
          "default": 0.0,
          "description": "LOW_HP: HP ratio below which it triggers.",
          "title": "Threshold",
          "type": "number"
        },
        "lane_wide": {
          "default": false,
          "description": "REGEN: heal the whole lane instead of self.",
          "title": "Lane Wide",
          "type": "boolean"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "Passive",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "threshold": {
          "description": "HP ratio that triggers the phase (first phase: 1.0).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "bonus": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Stat % bonuses while in this phase.",
          "propertyNames": {
            "enum": [
              "attack",
              "defense",
              "speed",
              "crit_rate"
            ]
          },
          "title": "Bonus",
          "type": "object"
        },
        "effects": {
          "description": "Applied to the boss on entering the phase.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "summons": {
          "items": {
            "$ref": "#/$defs/PhaseSummon"
          },
          "title": "Summons",
          "type": "array"
        },
        "shield_pct": {
          "default": 0.0,
          "description": "Shield gained on entering, as a share of max HP.",
          "minimum": 0.0,
          "title": "Shield Pct",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "name"
      ],
      "title": "Phase",
      "type": "object"
    },
    "PhaseSummon": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "lanes": {
          "items": {
            "type": "integer"
          },
          "title": "Lanes",
          "type": "array"
        }
      },
      "required": [
        "template_id",
        "lanes"
      ],
      "title": "PhaseSummon",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "hp": {
          "exclusiveMinimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "shields": {
          "default": 0,
          "minimum": 0,
          "title": "Shields",
          "type": "integer"
        },
        "attack": {
          "minimum": 0,
          "title": "Attack",
          "type": "integer"
        },
        "defense": {
          "minimum": 0,
          "title": "Defense",
          "type": "integer"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "integer"
        },
        "crit_rate": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Crit Rate",
          "type": "number"
        },
        "crit_damage": {
          "default": 1.5,
          "minimum": 1.0,
          "title": "Crit Damage",
          "type": "number"
        },
        "accuracy": {
          "default": 10,
          "title": "Accuracy",
          "type": "integer"
        },
        "resistance": {
          "default": 30,
          "title": "Resistance",
          "type": "integer"
        }
      },
      "required": [
        "hp",
        "attack",
        "defense",
        "speed"
      ],
      "title": "Stats",
      "type": "object"
    },
    "Summon": {
      "additionalProperties": false,
      "description": "An enemy-side summonable pack (scaled with the encounter).",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editor hint, ignored by the game.",
          "title": "$Schema"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "unit_hp": {
          "exclusiveMinimum": 0,
          "title": "Unit Hp",
          "type": "integer"
        },
        "unit_attack": {
          "minimum": 0,
          "title": "Unit Attack",
          "type": "integer"
        },
        "defense": {
          "default": 5,
          "title": "Defense",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "count",
        "unit_hp",
        "unit_attack"
      ],
      "title": "Summon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A colossal boss spanning all three lanes, optionally part of a planet hierarchy.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Editor hint, ignored by the game.",
      "title": "$Schema"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "planet": {
      "description": "Planet id: arena and loot table.",
      "title": "Planet",
      "type": "string"
    },
    "arena_name": {
      "title": "Arena Name",
      "type": "string"
    },
    "image": {
      "default": "/assets/bosses/zargul.svg",
      "title": "Image",
      "type": "string"
    },
    "art_hue": {
      "default": 0,
      "title": "Art Hue",
      "type": "integer"
    },
    "color": {
      "default": "#ef4444",
      "title": "Color",
      "type": "string"
    },
    "recommended_power": {
      "title": "Recommended Power",
      "type": "integer"
    },
    "stats": {
      "$ref": "#/$defs/Stats"
    },
    "max_difficulty": {
      "default": 10,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Difficulty",
      "type": "integer"
    },
    "passive": {
      "anyOf": [
        {
          "$ref": "#/$defs/Passive"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "abilities": {
      "items": {
        "$ref": "#/$defs/Ability"
      },
      "minItems": 1,
      "title": "Abilities",
      "type": "array"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/Phase"
      },
      "minItems": 1,
      "title": "Phases",
      "type": "array"
    },
    "summons": {
      "additionalProperties": {
        "$ref": "#/$defs/Summon"
      },
      "title": "Summons",
      "type": "object"
    },
    "rewards": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Base credits / crystals at difficulty 1.",
      "title": "Rewards",
      "type": "object"
    },
    "rank": {
      "anyOf": [
        {
          "enum": [
            "CAPTAIN",
            "LIEUTENANT",
            "OVERLORD"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "superior": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Boss id this champion answers to.",
      "title": "Superior"
    },
    "influence_required": {
      "default": 0,
      "minimum": 0,
      "title": "Influence Required",
      "type": "integer"
    },
    "guard": {
      "anyOf": [
        {
          "$ref": "#/$defs/Enemy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Elite that defends expeditions targeting this champion."
    },
    "recruit_template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Not used yet: hero template granted when claimed.",
      "title": "Recruit Template Id"
    },
    "claim_bonus": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Not used yet: seat bonus when claimed.",
      "title": "Claim Bonus",
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "title",
    "description",
    "planet",
    "arena_name",
    "recommended_power",
    "stats",
    "abilities",
    "phases"
  ],
  "title": "Boss",
  "type": "object",
  "$id": "boss.schema.json"
}
